---
import { SERIES } from '../data/series.js';
import { AS_OF } from '../data/site.js';
import Newsletter from '../components/Newsletter.astro';
const { title, description, schema = [], updated = AS_OF, footerNewsletter = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [['/calculator/','Calculator'],['/solar-backup/','Solar'],['/quotes/','Get quotes'],['/portable-power-stations/','Power stations'],['/whole-home-battery-cost/','Whole-home batteries'],['/what-size-battery-generator/','Sizing guide'],['/rebates/','Rebates']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
<meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" /><meta name="theme-color" content="#f6f8fc" media="(prefers-color-scheme: light)" />
<script is:inline>(function(){try{var t=localStorage.getItem('hbc-theme');if(t!=='light'&&t!=='dark'){t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'}document.documentElement.setAttribute('data-theme',t)}catch(e){}})();</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<style is:global>
:root{color-scheme:dark;--bg:#0b1020;--glow:#1d2a66;--panel:#121a33;--panel2:#18234a;--field:#0d1430;--deep:#0a0f24;--ink:#e8edff;--mute:#a7b2d6;--volt:#c6ff3d;--link:#c6ff3d;--on-volt:#0b1020;--amber:#ffb020;--line:#2c3866;--warn:#ffcf66;--ok:#5cf2a0;--bad:#ff8a8a;--hdr:rgba(11,16,32,.88);--hl1:#c6ff3d;--hl2:#ffb020}
:root[data-theme=light]{color-scheme:light;--bg:#f6f8fc;--glow:#e3ebff;--panel:#ffffff;--panel2:#f1f5fd;--field:#ffffff;--deep:#f4f7ff;--ink:#0d1530;--mute:#4a5578;--volt:#3d6b00;--link:#2a5a00;--on-volt:#ffffff;--amber:#b35c00;--line:#cdd6ea;--warn:#8a5a00;--ok:#0b7a43;--bad:#b42318;--hdr:rgba(246,248,252,.9);--hl1:#3d7a00;--hl2:#c25e00}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font:16px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:radial-gradient(1200px 600px at 80% -10%,var(--glow) 0,transparent 60%),var(--bg);color:var(--ink)}
a{color:var(--link)}a:hover{color:var(--ink)}
.wrap{max-width:1120px;margin:0 auto;padding:0 18px}
header.site{position:sticky;top:0;z-index:5;background:var(--hdr);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
header.site .wrap{display:flex;align-items:center;gap:16px;min-height:58px;flex-wrap:wrap}
.logo{font-weight:800;letter-spacing:-.02em;color:var(--ink);text-decoration:none;font-size:1.15rem;display:flex;align-items:center;gap:8px}
.logo b{color:var(--volt)}
nav.main{display:flex;gap:14px;flex-wrap:wrap;font-size:.92rem}nav.main a{color:var(--mute);text-decoration:none}nav.main a:hover{color:var(--ink)}
@media(max-width:760px){nav.main{order:3;width:100%;overflow-x:auto;flex-wrap:nowrap;padding-bottom:8px}nav.main a{white-space:nowrap}}
h1{font-size:clamp(1.8rem,4.5vw,3rem);line-height:1.1;letter-spacing:-.03em;margin:.4em 0}
h2{font-size:1.5rem;letter-spacing:-.02em;margin-top:2em}h3{margin-bottom:.3em}
.lede{color:var(--mute);font-size:1.1rem;max-width:720px}
.card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:16px;padding:20px}
.badge{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:2px 8px;border-radius:999px;border:1px solid currentColor}
.est{color:var(--warn)}.ok{color:var(--ok)}.bad{color:var(--bad)}.mute{color:var(--mute)}
.note{border-left:3px solid var(--warn);background:color-mix(in srgb,var(--warn) 8%,transparent);padding:10px 14px;border-radius:6px;font-size:.92rem}
.tbl{width:100%;overflow-x:auto;border:1px solid var(--line);border-radius:12px}
table{border-collapse:collapse;width:100%;font-size:.9rem}th,td{padding:9px 11px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--panel2);font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;color:var(--mute)}
.btn{display:inline-block;background:var(--volt);color:var(--on-volt);font-weight:800;border:0;border-radius:10px;padding:11px 18px;text-decoration:none;cursor:pointer;font-size:1rem}.btn:hover{background:var(--ink);color:var(--bg)}
.btn.ghost{background:transparent;color:var(--link);border:1px solid var(--link)}
.theme-btn{margin-left:auto;background:var(--panel2);color:var(--ink);border:1px solid var(--line);border-radius:999px;width:40px;height:40px;cursor:pointer;display:grid;place-items:center}.theme-btn svg{width:20px;height:20px}
:root[data-theme=light] .i-sun{display:none}:root:not([data-theme=light]) .i-moon{display:none}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
.src{font-size:.8rem;color:var(--mute)}.src a{color:var(--mute)}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
footer.site{margin-top:60px;border-top:1px solid var(--line);padding:30px 0;color:var(--mute);font-size:.88rem}
footer.site a{color:var(--mute)}
input,select,textarea{font:inherit;background:var(--field);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 10px}
details summary{cursor:pointer;font-weight:600}
.prep{position:relative;font-size:.92rem;margin-right:6px}.prep summary{list-style:none;cursor:pointer;color:var(--ink);font-weight:700;padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:var(--panel2);white-space:nowrap}.prep summary::-webkit-details-marker{display:none}.prep[open] summary{border-color:var(--volt)}
.prep-panel{position:absolute;top:calc(100% + 8px);left:0;z-index:50;min-width:280px;display:grid;gap:2px;padding:8px;background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.25)}.prep-panel a{color:var(--ink);text-decoration:none;padding:9px 10px;border-radius:8px}.prep-panel a:hover,.prep-panel a:focus{background:var(--panel2)}
@media(max-width:760px){header.site .wrap{position:relative}.prep{order:2;position:static}.prep-panel{left:12px;right:12px;min-width:0;top:auto;margin-top:8px}}
</style>
</head>
<body>
<header class="site"><div class="wrap">
<a class="logo" href="/"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="var(--volt)" d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg><span>Home<b>Backup</b>Cost</span></a>
<button class="theme-btn" id="themeBtn" type="button" aria-label="Switch light/dark theme" title="Switch light/dark theme"><svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
<details class="prep" id="prepMenu"><summary>Outage Prep <span aria-hidden="true">▾</span></summary><div class="prep-panel" role="menu">{SERIES.map(x => <a role="menuitem" href={x.href}><span aria-hidden="true">{x.icon}</span> {x.title}</a>)}</div></details>
<nav class="main" aria-label="Main">{nav.map(([h,t]) => <a href={h}>{t}</a>)}</nav>
</div></header>
<main class="wrap"><slot /></main>
<footer class="site"><div class="wrap">
{footerNewsletter && <Newsletter compact />}
<p><strong>HomeBackupCost</strong> — independent backup power sizing and cost data. Page data as of {updated}. Every figure links to its source; estimates are labeled <span class="badge est">Estimate</span>.</p>
<p><a href="/about/">About &amp; methodology</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/privacy/">Privacy</a> · <a href="/federal-tax-credits-ended/">Federal tax credits ended</a> · <a href="/llms.txt">llms.txt</a></p>
<p>Not electrical, legal, or tax advice. Have a licensed electrician connect anything to your home's wiring.</p>
</div></footer>
<script is:inline>document.getElementById('themeBtn').addEventListener('click',function(){var r=document.documentElement,t=r.getAttribute('data-theme')==='light'?'dark':'light';r.setAttribute('data-theme',t);try{localStorage.setItem('hbc-theme',t)}catch(e){}});</script>
<script is:inline>(function(){var d=document.getElementById('prepMenu');if(!d)return;document.addEventListener('click',function(e){if(d.open&&!d.contains(e.target))d.open=false});document.addEventListener('keydown',function(e){if(e.key==='Escape')d.open=false});})();</script>
</body></html>
