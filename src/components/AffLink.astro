---
import { productLink } from '../data/product-links.js';
const { product, label } = Astro.props;
const p = productLink(product);
---
{p ? <a class="btn ghost buy" href={p.url} rel="nofollow sponsored noopener" target="_blank" data-affiliate={p.affiliate ? 'live' : 'placeholder'} data-program={p.brand} data-product={p.name}>{label || `Check price at ${p.brand}`} ↗</a> : null}
