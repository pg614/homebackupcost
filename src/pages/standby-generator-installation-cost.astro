import Base from '../layouts/Base.astro';
const faq = [["How much does it cost to install a standby generator?", "Generac puts the average installed cost at $8,000\u2013$16,000, including the generator, equipment and installation (checked 2026-10-26). Long gas runs, larger liquid-cooled units, and panel upgrades push it higher."], ["Does the price include the transfer switch?", "Most published installed ranges include an automatic transfer switch. Confirm it is itemized on your quote."], ["Is there a federal tax credit for a standby generator?", "We have not found a federal tax credit for home standby generators. The battery credit (25D) ended for installs completed after 12/31/2025."]];
---
<Base title={"Standby Generator Installation Cost 2026: Fair Price Ranges | HomeBackupCost"} description={"What a whole-home standby generator costs installed in 2026: Generac says $8,000\u2013$16,000 including the unit. What is included, what adds cost, and how to check a quote."} schema={[{ '@context':'https://schema.org','@type':'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) }]}>
<h1>Standby generator installation cost (2026)</h1>
<p class="lede">Most published 2026 ranges for an installed whole-home standby generator, including the unit and transfer switch, land around $8,000–$16,000.</p>
<div class="grid">
<div class="card"><div class="mute">Generac (manufacturer)</div><div style="font-size:2rem;font-weight:800;color:var(--volt)">$8,000–$16,000</div><p>Average installed, including generator, equipment and installation.</p><div class="src"><a href="https://www.generac.com/resources/home-management/backup-generator-installation/">Generac</a> · as of 2026-10-26</div></div>
<div class="card"><div class="mute">US Home Costs planning range</div><div style="font-size:2rem;font-weight:800;color:var(--volt)">$8,000–$15,000</div><p>Air-cooled unit, automatic transfer switch, short gas run, pad, permit. National spread $5,000–$30,000.</p><div class="src"><a href="https://ushomecosts.com/guides/standby-generator-installation">ushomecosts.com</a> (updated 2026-10-09) · as of 2026-10-26</div></div>
</div>
<h2>What pushes a quote up</h2>
<ul><li>A liquid-cooled or larger unit</li><li>A long gas line, a gas meter upgrade, or a new propane tank</li><li>A panel or service upgrade forced by the transfer switch</li><li>Trenching or boring under a driveway</li></ul>
<p class="src">Cost drivers per <a href="https://ushomecosts.com/guides/standby-generator-installation">ushomecosts.com</a>, as of 2026-10-26.</p>
<h2>Generator or battery?</h2>
<p>EnergySage reports a typical installed whole-home battery (~13.5 kWh) at about $15,647. A battery needs no fuel, but covers fewer hours. <a href="/whole-home-battery-cost/">Battery costs →</a> · <a href="/what-size-battery-generator/">What size do I need? →</a></p>
<p>Not sure you need a standby unit? A portable generator with an inlet and interlock, or a <a href="/portable-power-stations/">portable power station</a>, costs less. See <a href="/transfer-switch-vs-interlock-kit/">transfer switch vs interlock kit</a>.</p>
<p>Next: <a href="/how-to-compare-backup-power-quotes/">how to compare quotes</a> · <a href="/questions-to-ask-backup-power-installer/">questions to ask an installer</a></p>
<p class="note"><a href="/quotes/"><strong>Get installer quotes →</strong></a> · <a href="/calculator/">Size your backup first with the calculator →</a></p>
