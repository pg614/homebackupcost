import Base from '../layouts/Base.astro';
import { EMAIL_LIVE } from '../data/email-config.js';
---
<Base title="Privacy Policy | HomeBackupCost" description="HomeBackupCost's privacy policy: the calculator runs in your browser, what happens when you ask us to email your report or join the newsletter, and we don't sell personal data.">
<h1>Privacy policy</h1>
<p class="src">Draft, effective date to be set at launch.</p>
{!EMAIL_LIVE && <p class="note"><strong>Email features are not switched on yet.</strong> The "Email me my report" form currently sends and stores nothing. The newsletter signup is live. The sections below describe how they will work once they are turned on.</p>}
<h2>The calculator</h2>
<p>The calculator and Quick Check run entirely in your browser. Your ZIP code, appliance choices, and state are not sent to us unless you ask us to email you your report.</p>
<h2>"Email me my report"</h2>
<ul>
<li><strong>What we collect:</strong> your email address, the calculator inputs and results shown on your screen (appliances, outage length, state, battery size, and the options and rebates listed), the page you were on, and the time you submitted. We do not collect your ZIP code, name, address, or phone number through this form.</li>
<li><strong>Consent:</strong> we only send the report if you tick the box "Send me my report and occasional backup power tips; unsubscribe anytime." Ticking it also adds you to our newsletter.</li>
<li><strong>How it's sent:</strong> your report is generated by our server (a Cloudflare Worker) and emailed through <a href="https://resend.com/legal/privacy-policy" target="_blank" rel="noopener">Resend</a>. We don't keep a separate copy of your report after it is sent; Resend keeps delivery logs under its own policy.</li>
</ul>
<h2>Newsletter</h2>
<ul>
<li><strong>What we collect:</strong> your email address, entered in our newsletter signup form.</li>
<li><strong>Where it goes:</strong> the form sends your address directly to our newsletter provider, <a href="https://kit.com/privacy" target="_blank" rel="noopener">Kit</a> (formerly ConvertKit). It is used for the HomeBackupCost newsletter only. Kit may record whether emails are opened or links are clicked.</li>
<li><strong>What you get:</strong> occasional emails when prices, rebates, or outage guidance change. You'll be asked to confirm your subscription first.</li>
<li><strong>Unsubscribe:</strong> every email has an unsubscribe link. You can also email us to have your address deleted.</li>
</ul>
<h2>Spam protection</h2>
<p>To block abuse, our server briefly uses your IP address to limit how many requests can be made in a short time. We don't store it with your email address.</p>
<h2>Everything else</h2>
<ul>
<li><strong>Analytics:</strong> none is installed right now. If we add privacy-friendly, cookieless analytics later, we'll list it here.</li>
<li><strong>Affiliate links:</strong> retailers you visit through our links may set their own cookies under their own privacy policies.</li>
<li>We do not sell or rent personal information, and we don't share your email with installers or brands.</li>
</ul>
</Base>
