---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import QuickCheck from '../components/QuickCheck.astro';
import Newsletter from '../components/Newsletter.astro';
const faq = [
 ['How big a battery do I need to run a fridge during an outage?', 'A refrigerator draws about 150–400 running watts and 800–1,200 watts to start (Champion Power Equipment chart). If the compressor runs about a third of the time (our assumption), that is roughly 1–3 kWh per day. Use the calculator to add your other essentials.'],
 ['Is there still a federal tax credit for home batteries?', 'No. Under the 2025 law known as the One Big Beautiful Bill, the Section 25D credit does not apply to installations completed after 12/31/2025, per the IRS FAQ.'],
 ['How much does a whole-home battery cost installed?', 'EnergySage reports about $15,647 typical for roughly 13.5 kWh, or about $1,130–$1,159 per kWh, as of 2026-10-25.'],
];
const schema = [
 { '@context':'https://schema.org','@type':'WebSite', name:'HomeBackupCost', url:'https://homebackupcost.com/' },
 { '@context':'https://schema.org','@type':'WebApplication', name:'Backup Power Calculator', applicationCategory:'UtilitiesApplication', operatingSystem:'Any', url:'https://homebackupcost.com/calculator/', offers:{ '@type':'Offer', price:'0', priceCurrency:'USD' } },
 { '@context':'https://schema.org','@type':'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
];
---
<Base footerNewsletter={false} title="Home Backup Power Calculator: Battery Size, Cost & Rebates | HomeBackupCost" description="Pick what you need to keep running in an outage and see the battery size (kWh), peak watts, matching power stations, whole-home battery cost, and rebates in your state." schema={schema}>
<section class="hero">
<div class="splash"><picture class="art art-light"><source media="(max-width: 720px)" type="image/avif" srcset="/hero/light-v3-m640.avif 640w, /hero/light-v3-m960.avif 960w" sizes="100vw" /><source media="(max-width: 720px)" type="image/webp" srcset="/hero/light-v3-m640.webp 640w, /hero/light-v3-m960.webp 960w" sizes="100vw" /><source type="image/avif" srcset="/hero/light-v2-640.avif 640w, /hero/light-v2-960.avif 960w, /hero/light-v2-1280.avif 1280w" sizes="100vw" /><img id="hero-light" src="/hero/light-v2-1280.webp" srcset="/hero/light-v2-640.webp 640w, /hero/light-v2-960.webp 960w, /hero/light-v2-1280.webp 1280w" sizes="100vw" width="1280" height="720" loading="lazy" fetchpriority="high" decoding="async" alt="Illustration of a sunny American farmhouse with solar panels on the roof, a glowing green home backup battery beside the house, an American flag in the yard, and children playing with their dog" /></picture><picture class="art art-dark"><source media="(max-width: 720px)" type="image/avif" srcset="/hero/dark-v2-m640.avif 640w, /hero/dark-v2-m960.avif 960w" sizes="100vw" /><source media="(max-width: 720px)" type="image/webp" srcset="/hero/dark-v2-m640.webp 640w, /hero/dark-v2-m960.webp 960w" sizes="100vw" /><source type="image/avif" srcset="/hero/dark-v2-640.avif 640w, /hero/dark-v2-960.avif 960w, /hero/dark-v2-1280.avif 1280w" sizes="100vw" /><img id="hero-dark" src="/hero/dark-v2-1280.webp" srcset="/hero/dark-v2-640.webp 640w, /hero/dark-v2-960.webp 960w, /hero/dark-v2-1280.webp 1280w" sizes="100vw" width="1280" height="720" loading="lazy" fetchpriority="high" decoding="async" alt="Illustration of a farmhouse at night during a power outage, windows lit by its rooftop solar panels and glowing green home battery while the neighboring farm sits dark, as children with lanterns play near the American flag" /></picture><script is:inline>(function(){var t=document.documentElement.getAttribute('data-theme')==='light'?'light':'dark';var i=document.getElementById('hero-'+t);if(i){i.loading='eager';}})();</script></div>
<div class="hero-copy">
<p class="eyebrow"><span class="dot"></span> Free calculator · Sourced data, as of 2026-10-25</p>
<h1>How much backup power does <span class="hl">your home</span> really need?</h1>
<p class="lede">Enter your ZIP and answer 3 quick questions. You'll get a ballpark battery size, the cheapest setup that covers it, installed and generator options, and your state's rebates, with a source for every number.</p>
</div>
<QuickCheck />
</section>
<h2 id="full">Full calculator: pick every appliance</h2>
<Calculator />
<section class="grid" style="margin-top:36px">
<a class="card tile" href="/portable-power-stations/"><h3>Portable power stations compared</h3><p class="mute">Capacity, output, surge, and price for 11 models, with price dates.</p></a>
<a class="card tile" href="/whole-home-battery-cost/"><h3>Whole-home battery cost</h3><p class="mute">Powerwall 3, FranklinWH, and EnergySage's installed price data.</p></a>
<a class="card tile" href="/what-size-battery-generator/"><h3>What size do I need?</h3><p class="mute">Running vs. starting watts, kWh, and worked examples.</p></a>
<a class="card tile" href="/rebates/"><h3>Rebates by state</h3><p class="mute">HOMES/HEAR status for every state plus utility programs.</p></a>
</section>
<h2>Quick answers</h2>
{faq.map(([q,a]) => <details class="card" style="margin-bottom:10px"><summary>{q}</summary><p>{a}</p></details>)}
<Newsletter />
<style>
.hero{padding:0 0 18px;position:relative}
.splash{position:relative;margin:0 calc(50% - 50vw);height:min(56vw,520px);overflow:hidden}
.art{display:none}.art img{width:100%;height:100%;object-fit:cover;object-position:70% 60%;display:block}
:root[data-theme=light] .art-light,:root:not([data-theme=light]) .art-dark{display:block;height:100%}
.splash::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,color-mix(in srgb,var(--bg) 88%,transparent) 0%,color-mix(in srgb,var(--bg) 55%,transparent) 38%,transparent 62%),linear-gradient(to bottom,transparent 70%,var(--bg) 100%)}
.hero-copy{position:relative;margin-top:calc(-1 * min(56vw,520px));padding:56px 0 0;max-width:600px;min-height:calc(min(56vw,520px) - 40px)}
.hero-copy h1{font-size:clamp(2rem,4.4vw,3.2rem);line-height:1.08}
.hero > :global(:not(.splash)){position:relative;z-index:1}
.hero .lede{max-width:540px;font-weight:500}
@media(max-width:720px){.splash{height:72vw}.art img{object-position:50% 50%}.splash::after{background:linear-gradient(to bottom,transparent 60%,var(--bg) 100%)}.hero-copy{margin-top:0;padding-top:14px;min-height:0}}.eyebrow{color:var(--mute);font-size:.85rem;display:flex;gap:8px;align-items:center}
.dot{width:8px;height:8px;border-radius:50%;background:var(--volt);box-shadow:0 0 12px var(--volt)}
.hl{background:linear-gradient(90deg,var(--hl1),var(--hl2));-webkit-background-clip:text;background-clip:text;color:transparent}
.tile{text-decoration:none;color:var(--ink)}.tile:hover{border-color:var(--volt)}.tile h3{margin-top:0}
@media(max-width:600px){.hero{padding:14px 0 8px}.hero .lede{font-size:1rem}}
</style>
</Base>
