---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import AffLink from '../components/AffLink.astro';
import { batteries, costs } from '../data/site.js';
const inst = batteries.filter(b => b.type.startsWith('installed'));
const faq = [['How much does a Tesla Powerwall 3 cost?','A comparison site lists the Powerwall 3 (13.5 kWh) equipment at $9,300, with installation extra (homegridhq.com, October 2026). EnergySage reports a typical installed cost of about $15,647 for a battery of about 13.5 kWh.'],['Is there a federal tax credit for home batteries in 2026?','No. The IRS says installations completed after 12/31/2025 are not eligible for the Section 25D credit.']];
const schema = [{ '@context':'https://schema.org','@type':'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) }];
---
<Base title="Whole-Home Battery Cost 2026: Powerwall 3, FranklinWH & Installed Prices | HomeBackupCost" description="What a whole-home backup battery costs installed in 2026: about $15,647 typical for 13.5 kWh (EnergySage), Powerwall 3 and FranklinWH aPower 2 specs, and what's changed with tax credits." schema={schema}>
<h1>Whole-home battery cost</h1>
<p class="lede">An installed battery, like the Tesla Powerwall, is wired into your panel and switches on automatically when the grid goes down.</p>
<div class="grid">
<div class="card"><div class="mute">Typical installed (~13.5 kWh)</div><div style="font-size:2.2rem;font-weight:800;color:var(--volt)">~$15,647</div><div class="src"><a href="https://www.energysage.com/energy-storage/how-much-do-batteries-cost/">EnergySage</a> · as of 2026-10-25</div></div>
<div class="card"><div class="mute">Per kWh installed</div><div style="font-size:2.2rem;font-weight:800;color:var(--volt)">$1,130–$1,159</div><div class="src"><a href="https://www.energysage.com/energy-storage/how-much-do-batteries-cost/">EnergySage</a> · as of 2026-10-25</div></div>
<div class="card"><div class="mute">Federal tax credit</div><div style="font-size:2.2rem;font-weight:800;color:var(--bad)">Ended</div><div class="src">For installs after 12/31/2025 · <a href="/federal-tax-credits-ended/">details</a></div></div>
</div>
<h2>Installed batteries in our data</h2>
<div class="tbl"><table><thead><tr><th>Battery</th><th>Capacity</th><th>Output</th><th>Surge</th><th>Price listed</th><th></th></tr></thead><tbody>
{inst.map(b => <tr><td><strong>{b.product}</strong></td><td>{b.capacity_kwh} kWh</td><td>{b.output_w.toLocaleString()} W</td><td>{b.surge_w.toLocaleString()} W</td><td>{b.price}<br/><a class="src" href={b.source_url}>source</a> <span class="src">({b.as_of})</span></td><td><AffLink product={b.product} label="Maker's page" /></td></tr>)}
</tbody></table></div>
<h2>All cost data</h2>
<div class="tbl"><table><thead><tr><th>Item</th><th>Cost</th><th>Source</th></tr></thead><tbody>
{costs.map(c => <tr><td>{c.item}</td><td>{c.range}{/estimate/i.test(c.range) && <> <span class="badge est">Estimate</span></>}</td><td><a class="src" href={c.source}>{new URL(c.source).hostname}</a></td></tr>)}
</tbody></table></div>
<p class="src">As of 2026-10-25. Heat pump and panel costs are included because a battery project often comes with a panel upgrade.</p>
<h2>Installed battery or a big portable?</h2>
<p>A large portable station plus a transfer kit can back up selected circuits for less money. For example, an EcoFlow DELTA Pro 3 ($2,799 sale) plus a Smart Home Panel 2 ($1,599) comes to $4,398 before electrician labor, which we don't have sourced data for. An installed battery switches over automatically and runs more circuits. <a href="/portable-power-stations/">Compare portables →</a></p>
<p class="note"><strong>Get quotes:</strong> an installer-quote button (EnergySage) will go here once a partnership is approved. <span data-affiliate="placeholder" data-affiliate-brand="EnergySage">Placeholder — not active.</span></p>
<h2>FAQ</h2>
{faq.map(([q,a]) => <details class="card" style="margin-bottom:10px"><summary>{q}</summary><p>{a}</p></details>)}
<p><a class="btn" href="/calculator/">Size your whole-home battery</a></p>
<Newsletter />
</Base>
